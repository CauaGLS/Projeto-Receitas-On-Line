# Copie este arquivo para .env (ou apenas exporte as variáveis no ambiente
# do seu servidor/PHP) e preencha com os valores reais do seu ambiente.
# Este projeto não usa framework, então essas variáveis precisam ser
# disponibilizadas via getenv() — configure-as no seu servidor web (Apache
# SetEnv, php.ini, Docker, etc.) ou carregue um .env com alguma ferramenta
# de sua preferência antes de rodar o PHP embutido.

# Host do servidor MySQL
DB_HOST=localhost

# Usuário do MySQL
DB_USER=root

# Senha do MySQL
DB_PASS=

# Nome do banco de dados (criado a partir de "Query Receitas On-LineHU2.sql")
DB_NAME=receitasonline
